    "New creates a server with default settings. Copy duplicates this one. The last server can't be deleted. vkLink and VK account auth are global (Settings screen), not per-server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New creates a server with default settings. Copy duplicates this one. The last server can't be deleted. vkLink and VK account auth are global (Settings screen), not per-server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Новый» создаёт сервер с настройками по умолчанию. «Копировать» дублирует текущий. Последний сервер удалить нельзя. vkLink и авторизация VK-аккаунта — глобальные (экран «Настройки»), а не для каждого сервера."
          }
        }
      }
    },
