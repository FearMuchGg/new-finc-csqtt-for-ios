    "Deletes the cached TURN credentials. The pool will be rebuilt on next connect via the regular VK API + captcha flow.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the cached TURN credentials. The pool will be rebuilt on next connect via the regular VK API + captcha flow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет кэшированные учётные данные TURN. Пул будет создан заново при следующем подключении через обычный VK API и капчу."
          }
        }
      }
    },
    "Deletes the captured browser fingerprint used by the auto-PoW captcha solver. Until the next manual captcha solve, the solver will use generated values which VK detects as bot far more often.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the captured browser fingerprint used by the auto-PoW captcha solver. Until the next manual captcha solve, the solver will use generated values which VK detects as bot far more often."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет сохранённый отпечаток браузера, который использует авторешатель PoW-капчи. До следующего ручного решения капчи решатель будет использовать сгенерированные значения, которые VK гораздо чаще считает ботом."
          }
        }
      }
    },
