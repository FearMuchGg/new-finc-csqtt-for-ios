    "Backup contains all settings, WireGuard keys, TURN credentials, and the captured browser profile. Treat the exported file as a secret.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup contains all settings, WireGuard keys, TURN credentials, and the captured browser profile. Treat the exported file as a secret."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия содержит все настройки, ключи WireGuard, учётные данные TURN и сохранённый профиль браузера. Считайте экспортированный файл секретом."
          }
        }
      }
    },
