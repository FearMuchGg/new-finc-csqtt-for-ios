    "csqtt.common.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить"
          }
        }
      }
    },
    "csqtt.empty.logs.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect once and the app will start reporting what the tunnel does."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь один раз — и приложение начнёт рассказывать, что делает туннель."
          }
        }
      }
    },
    "csqtt.empty.logs.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing logged yet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записей пока нет"
          }
        }
      }
    },
    "csqtt.empty.servers.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a server profile or paste a connection link to get started."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте профиль сервера или вставьте ссылку подключения."
          }
        }
      }
    },
    "csqtt.empty.servers.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No servers yet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверов пока нет"
          }
        }
      }
    },
    "csqtt.onboarding.feature.control.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Live Activity shows the state and, on iOS 17+, can disconnect, switch server or bypass the tunnel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity показывает состояние и на iOS 17+ позволяет отключиться, сменить сервер или пустить трафик мимо туннеля."
          }
        }
      }
    },
    "csqtt.onboarding.feature.control.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control from the Lock Screen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управление с экрана блокировки"
          }
        }
      }
    },
    "csqtt.onboarding.feature.privacy.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DTLS-SRTP derives fresh session keys; if the server answers no handshake, the password-derived keys keep the tunnel up."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DTLS-SRTP выводит свежие ключи сессии; если сервер не отвечает рукопожатием, туннель продолжает работать на ключах из пароля."
          }
        }
      }
    },
    "csqtt.onboarding.feature.privacy.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys from a handshake"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи из рукопожатия"
          }
        }
      }
    },
    "csqtt.onboarding.feature.speed.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The client keeps several streams to one server and restarts only the one that stalls."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клиент держит несколько потоков к одному серверу и перезапускает только зависший."
          }
        }
      }
    },
    "csqtt.onboarding.feature.speed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parallel streams"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параллельные потоки"
          }
        }
      }
    },
    "csqtt.onboarding.features.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you get"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы получаете"
          }
        }
      }
    },
    "csqtt.onboarding.next": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить"
          }
        }
      }
    },
    "csqtt.onboarding.ready.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings, add your server profile (or paste a csqtt:// link), then tap Connect on the main screen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Настройки», добавьте профиль сервера (или вставьте ссылку csqtt://), затем нажмите «Подключить» на главном экране."
          }
        }
      }
    },
    "csqtt.onboarding.ready.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a server to start"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте сервер, чтобы начать"
          }
        }
      }
    },
    "csqtt.onboarding.skip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропустить"
          }
        }
      }
    },
    "csqtt.onboarding.start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать"
          }
        }
      }
    },
    "csqtt.onboarding.welcome.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CSQTT carries your traffic through a TURN relay and shapes it as media, so restrictive networks see a call instead of a VPN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CSQTT передаёт трафик через TURN-ретранслятор и маскирует его под медиа: ограничивающие сети видят звонок, а не VPN."
          }
        }
      }
    },
    "csqtt.onboarding.welcome.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tunnel that looks like a call"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туннель, похожий на звонок"
          }
        }
      }
    },
