    "Returns Connected or Disconnected. Connected means a VPN session exists — it does not confirm that traffic is crossing it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns Connected or Disconnected. Connected means a VPN session exists — it does not confirm that traffic is crossing it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает «Подключено» или «Отключено». «Подключено» означает, что сеанс VPN существует, но не подтверждает, что трафик идёт через него."
          }
        }
      }
    },
    "Route around the tunnel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Route around the tunnel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В обход туннеля"
          }
        }
      }
    },
    "Routes traffic around the tunnel, or puts it back through it. Requires a running connection; this does not connect or disconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routes traffic around the tunnel, or puts it back through it. Requires a running connection; this does not connect or disconnect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направляет трафик в обход туннеля или возвращает его обратно. Нужно активное подключение; команда не подключает и не отключает VPN."
          }
